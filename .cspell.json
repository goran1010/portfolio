{
  "version": "0.2",
  "language": "en",
  "files": [
    "src/**/*.{ts,tsx,json}",
    "__tests__/**/*.{ts,tsx}",
    "e2e/**/*.ts",
    "index.html",
    "public/404.html",
    "README.md",
    ".github/**/*.{yml,yaml,md}"
  ],
  "ignorePaths": ["**/node_modules/**", "**/dist/**", "**/coverage/**"],
  "import": [
    "@cspell/cspell-bundled-dicts",
    "@cspell/dict-hr-hr/cspell-ext.json",
    "@cspell/dict-sr-latn/cspell-ext.json"
  ],
  "dictionaries": ["hr-hr", "sr-latn"],
  "words": [
    "GitHubu",
    "METR",
    "nvmrc",
    "pullrequests",
    "requestove",
    "unstub",
    "zoomable"
  ]
}
